@ENABLE_TC_TRUE@libjerasure_la_SOURCES = \
@ENABLE_TC_TRUE@	tc/jerasure/src/jerasure.c \
@ENABLE_TC_TRUE@	tc/jerasure/src/reed_sol.c \
@ENABLE_TC_TRUE@	tc/jerasure/src/galois.c \
@ENABLE_TC_TRUE@	tc/jerasure/src/cauchy.c \
@ENABLE_TC_TRUE@	tc/jerasure/src/liberation.c

@ENABLE_TC_TRUE@libjerasure_la_CFLAGS = -I$(srcdir)/tc/jerasure/include -I$(srcdir)/tc/gf-complete/include -w
@ENABLE_TC_TRUE@libjerasure_la_LIBADD = libgfcomplete.la

# ION FEC wrapper library
@ENABLE_TC_TRUE@libionfec_la_SOURCES = tc/library/ion_fec.c
@ENABLE_TC_TRUE@libionfec_la_CFLAGS = $(AM_CFLAGS) -I$(srcdir)/tc/include -I$(srcdir)/tc/jerasure/include -I$(srcdir)/tc/gf-complete/include
@ENABLE_TC_TRUE@libionfec_la_LIBADD = libjerasure.la libgfcomplete.la

# --- DTKA Executables --- #
@ENABLE_TC_TRUE@dtka_SOURCES = tc/dtka/dtka.c
