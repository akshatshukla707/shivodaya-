@ENABLE_GCOV_FALSE@cov-clean:
@ENABLE_GCOV_FALSE@	@echo "You must use \"configure --with-gcov\" to enable coverage testing features"

@ENABLE_GCOV_FALSE@cov-report:
@ENABLE_GCOV_FALSE@	@echo "You must use \"configure --with-gcov\" to enable coverage testing features"

@ENABLE_GCOV_FALSE@cov:
@ENABLE_GCOV_FALSE@	@echo "You must use \"configure --with-gcov\" to enable coverage testing features"

