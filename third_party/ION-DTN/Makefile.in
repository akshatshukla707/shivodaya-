# -- Libraries --- #

# Always compile ion_atomic.c.  Its internal #if !ION_HAVE_C11_ATOMICS guard
# compiles the function bodies to nothing on C11 builds, so this is safe.
# The file must be unconditionally present so that CFLAGS-based tier overrides
# (ION_TEST_FORCE_FALLBACK) can switch to the mutex-backed fallback at compile
# time without a link failure.
libici_la_SOURCES = ici/bulk/STUB_BULK/bulk.c ici/library/cbor.c \
	ici/library/crc.c ici/library/ion.c ici/library/ion_admin.c \
	ici/library/ion_network.c ici/library/ionsec.c \
	ici/library/libicinm.c ici/library/llcv.c ici/library/lyst.c \
	ici/library/memmgr.c ici/library/platform.c \
	ici/library/platform_sm.c ici/library/psm.c \
	ici/library/radix.c ici/library/rfx.c ici/library/smlist.c \
	ici/library/smrbt.c ici/library/sptrace.c ici/library/zco.c \
	ici/sdr/sdrcatlg.c ici/sdr/sdrhash.c ici/sdr/sdrlist.c \
	ici/sdr/sdrmgt.c ici/sdr/sdrstring.c ici/sdr/sdrtable.c \
	ici/sdr/sdrxn.c ici/sdr/sdr_perf.c ici/crypto/entropy_src.c \
	ici/library/ion_atomic.c $(am__append_23) $(am__append_25)
libici_la_CFLAGS = $(icicflags) $(AM_CFLAGS)
libici_la_LIBADD = $(CRYPTO_LIBS) -lm

# --- Utility Programs --- #
ionadmin_SOURCES = ici/utils/ionadmin.c
ionadmin_LDADD = libici.la -lm $(LINENOISE_LDADD)
ionadmin_CFLAGS = $(icicflags) $(AM_CFLAGS) $(LINENOISE_CFLAGS)
