	ionunlock ionwarn owltsim psmshell psmwatch rfxclock sdr2file \
	reversibility_correctness_test robust_lock_recovery_test \
	psm_robust_recovery_test ipc_lock_recovery_test cbor_oob_test \
	sdrcancel sdr_frag_stress sdrmend sdrwatch sm2file smlistsh \
	smrbtsh ionxnowner owlttb
