BP_SRC_DIR = $(srcdir)/bpv7

# Define pod2man stuff
bpPODM1 = pod2man -s 1 -c "BP executables"
bpPODM3 = pod2man -s 3 -c "BP library functions"
bpPODM5 = pod2man -s 5 -c "BP configuration files"
bpcflags = -I$(BP_SRC_DIR)/bpsec/instr -I$(BP_SRC_DIR)/bpsec/policy \
	-I$(BP_SRC_DIR)/bpsec/sci -I$(BP_SRC_DIR)/bpsec/utils \
	-I$(BP_SRC_DIR)/library -I$(BP_SRC_DIR)/library/ext \
	-I$(BP_SRC_DIR)/library/ext/meb \
	-I$(BP_SRC_DIR)/library/ext/bae -I$(BP_SRC_DIR)/include \
	-I$(BP_SRC_DIR)/ipn -I$(BP_SRC_DIR)/ipnd \
	-I$(srcdir)/ici/libbloom-master \
	-I$(srcdir)/ici/libbloom-master/murmur2 -I$(BP_SRC_DIR)/dtn2 \
	-I$(BP_SRC_DIR)/library/crypto -I$(BP_SRC_DIR)/tcp \
	-I$(BP_SRC_DIR)/udp -I$(srcdir)/ici/include \
	-I$(srcdir)/ici/library -I$(BP_SRC_DIR)/library/ext/snw \
	-I$(BP_SRC_DIR)/bibe -I$(BP_SRC_DIR)/imc -DBP_EXTENDED \
	-I$(BP_SRC_DIR)/saga -I$(BP_SRC_DIR)/library/ext/bpsec \
	-I$(BP_SRC_DIR)/library/ext/hcb \
	-I$(BP_SRC_DIR)/library/ext/pnb \
	-I$(BP_SRC_DIR)/library/ext/bpq \
	-I$(BP_SRC_DIR)/library/ext/creb \
	-I$(BP_SRC_DIR)/library/ext/cteb -I$(srcdir)/bpv7/metadata \
	-I$(srcdir)/ici/crypto/NULL_SUITES $(am__append_15)
bpbin = bibeadmin bibeclo bpadmin bpcancel bpclm bpclock bpcounter \
	bpcrash bpcrash_hard bpdriver bpecho bping bpinspect bplist \
	bpnmtest bprecvfile bprecvmeta bprecvtest bpsendfile \
	bpsendmeta bpsendtest bpsink bpsource cbrcustodytest bpstats \
	bpwatch bptrace bptracker bptransit brsccla brsscla cgrfetch \
	dtn2admin dtn2adminep dtn2fw hmackeys ipnadmin ipnadminep ipnd \
	ipnfw lgagent lgsend ltpcli ltpclo recvfile sendfile sppcli \
	sppclo eppcli eppclo filecli fileclo stcpcli stcpclo tcpcli \
	tcpclo udpcli udpclo bpchat bpstats2 $(am__append_16) \
	$(am__append_17) $(am__append_18)
bplib = \
	libbp.la \
	libcgr.la \
	libsppcla.la \
	libeppcla.la \
	libstcpcla.la \
	libudpcla.la

bpinclude = \
	bpv7/include/bp.h \
	bpv7/include/bp_admin.h \
	bpv7/include/eureka.h

bpnoinst = \
