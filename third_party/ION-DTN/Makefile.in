am__noinst_HEADERS_DIST = ici/library/lystP.h ici/library/radixP.h \
	ici/sdr/sdrP.h ici/test/file2sdr.h ltp/library/ltpP.h \
	ltp/library/ltpsec.h ltp/udp/udplsa.h ltp/xlsa/xlsa.h \
