# GF-Complete library (Galois Field arithmetic)
# Note: This is vendored third-party code; suppress warnings that are treated as errors
@ENABLE_TC_TRUE@libgfcomplete_la_SOURCES = \
@ENABLE_TC_TRUE@	tc/gf-complete/src/gf.c \
@ENABLE_TC_TRUE@	tc/gf-complete/src/gf_w4.c \
@ENABLE_TC_TRUE@	tc/gf-complete/src/gf_w8.c \
@ENABLE_TC_TRUE@	tc/gf-complete/src/gf_w16.c \
@ENABLE_TC_TRUE@	tc/gf-complete/src/gf_w32.c \
@ENABLE_TC_TRUE@	tc/gf-complete/src/gf_w64.c \
@ENABLE_TC_TRUE@	tc/gf-complete/src/gf_w128.c \
@ENABLE_TC_TRUE@	tc/gf-complete/src/gf_wgen.c \
@ENABLE_TC_TRUE@	tc/gf-complete/src/gf_general.c \
@ENABLE_TC_TRUE@	tc/gf-complete/src/gf_rand.c \
@ENABLE_TC_TRUE@	tc/gf-complete/src/gf_method.c \
@ENABLE_TC_TRUE@	tc/gf-complete/src/gf_cpu.c

@ENABLE_TC_TRUE@libgfcomplete_la_CFLAGS = -I$(srcdir)/tc/gf-complete/include -w

# Jerasure library (Reed-Solomon erasure coding)
