.PRECIOUS: Makefile

#	$(twonodestcp_DATA) \
#	$(threenodestcpltp_DATA)

# This hook now explicitly depends on the completion of all programs and
# libraries. It checks for a flag file to ensure it only runs ONCE per build.

# BSL v1.1 builds as a standalone library (no ION dependencies).
# Build BSL first, then build ION linking against BSL.
@ENABLE_BSL_TRUE@all: all-bsl

@ENABLE_BSL_TRUE@all-bsl:
@ENABLE_BSL_TRUE@	@echo "========================================"
@ENABLE_BSL_TRUE@	@echo "Stage 1: Building BSL..."
@ENABLE_BSL_TRUE@	@echo "========================================"
@ENABLE_BSL_TRUE@	@$(srcdir)/build-bsl-for-ion.sh
@ENABLE_BSL_TRUE@	@echo "========================================"
@ENABLE_BSL_TRUE@	@echo "Stage 2: Building ION..."
@ENABLE_BSL_TRUE@	@echo "========================================"
@ENABLE_BSL_TRUE@	$(MAKE) $(AM_MAKEFLAGS) all-am

@ENABLE_BSL_TRUE@all-local: $(bin_PROGRAMS) $(lib_LTLIBRARIES) $(man_MANS)
@ENABLE_BSL_FALSE@all-local: $(bin_PROGRAMS) $(lib_LTLIBRARIES) $(man_MANS)
@ENABLE_INSTALL_MESSAGES_TRUE@	@if test -f configure && [ ! -f .build_finished ]; then \
@ENABLE_INSTALL_MESSAGES_TRUE@		echo ""; \
@ENABLE_INSTALL_MESSAGES_TRUE@		echo '    ┌───────────────────────────────────────────────────────────┐'; \
@ENABLE_INSTALL_MESSAGES_TRUE@		echo '    │                                                           │'; \
@ENABLE_INSTALL_MESSAGES_TRUE@		echo '    │   BUILD COMPLETE.                                         │'; \
@ENABLE_INSTALL_MESSAGES_TRUE@		echo '    │                                                           │'; \
@ENABLE_INSTALL_MESSAGES_TRUE@		echo '    │   Next, install ION-DTN by running:                       │'; \
@ENABLE_INSTALL_MESSAGES_TRUE@		echo '    │                                                           │'; \
@ENABLE_INSTALL_MESSAGES_TRUE@		echo '    │   [sudo] make install                                     │'; \
@ENABLE_INSTALL_MESSAGES_TRUE@		echo '    │                                                           │'; \
@ENABLE_INSTALL_MESSAGES_TRUE@		echo '    └───────────────────────────────────────────────────────────┘'; \
@ENABLE_INSTALL_MESSAGES_TRUE@		echo ""; \
@ENABLE_INSTALL_MESSAGES_TRUE@		touch .build_finished; \
@ENABLE_INSTALL_MESSAGES_TRUE@	fi

@ENABLE_BSL_TRUE@install-exec-hook:
@ENABLE_BSL_TRUE@	@echo "Installing BSL shared libraries to $(DESTDIR)$(libdir)..."
@ENABLE_BSL_TRUE@	@for d in $(BSL_LIB_DIR64) $(BSL_LIB_DIR32); do \
@ENABLE_BSL_TRUE@		test -d "$$d" || continue; \
@ENABLE_BSL_TRUE@		cp -pPR "$$d"/libbsl_*.so* $(DESTDIR)$(libdir)/; \
@ENABLE_BSL_TRUE@		cp -pPR "$$d"/libqcbor.so* $(DESTDIR)$(libdir)/; \
@ENABLE_BSL_TRUE@		break; \
@ENABLE_BSL_TRUE@	done

# This hook contains the final message after a successful installation.
install-data-hook:
@ENABLE_INSTALL_MESSAGES_TRUE@	@echo '    ───────────────────────────────────────────────────────────'
@ENABLE_INSTALL_MESSAGES_TRUE@	@echo
@ENABLE_INSTALL_MESSAGES_TRUE@	@echo '    ██╗ ██████╗ ███╗   ██╗         ██████╗ ████████╗███╗   ██╗'
@ENABLE_INSTALL_MESSAGES_TRUE@	@echo '    ██║██╔═══██╗████╗  ██║         ██╔══██╗╚══██╔══╝████╗  ██║'
@ENABLE_INSTALL_MESSAGES_TRUE@	@echo '    ██║██║   ██║██╔██╗ ██║ ██████╗ ██║  ██║   ██║   ██╔██╗ ██║'
@ENABLE_INSTALL_MESSAGES_TRUE@	@echo '    ██║██║   ██║██║╚██╗██║ ╚═════╝ ██║  ██║   ██║   ██║╚██╗██║'
@ENABLE_INSTALL_MESSAGES_TRUE@	@echo '    ██║╚██████╔╝██║ ╚████║         ██████╔╝   ██║   ██║ ╚████║'
@ENABLE_INSTALL_MESSAGES_TRUE@	@echo '    ╚═╝ ╚═════╝ ╚═╝  ╚═══╝         ╚═════╝    ╚═╝   ╚═╝  ╚═══╝'
@ENABLE_INSTALL_MESSAGES_TRUE@	@echo
@ENABLE_INSTALL_MESSAGES_TRUE@	@echo '    INSTALLATION SUCCESSFUL.'
@ENABLE_INSTALL_MESSAGES_TRUE@	@echo
@ENABLE_INSTALL_MESSAGES_TRUE@	@echo '    [ Linux ]'
@ENABLE_INSTALL_MESSAGES_TRUE@	@echo '    To register the new ION libraries, run:'
@ENABLE_INSTALL_MESSAGES_TRUE@	@echo '    sudo ldconfig'
@ENABLE_INSTALL_MESSAGES_TRUE@	@echo
@ENABLE_INSTALL_MESSAGES_TRUE@	@echo '    [ macOS ]'
@ENABLE_INSTALL_MESSAGES_TRUE@	@echo '    If you have runtime loading issues, run:'
@ENABLE_INSTALL_MESSAGES_TRUE@	@echo '    sudo update_dyld_shared_cache -force'
@ENABLE_INSTALL_MESSAGES_TRUE@	@echo
@ENABLE_INSTALL_MESSAGES_TRUE@	@echo '    To fix mbedtls library paths specifically, run:'
@ENABLE_INSTALL_MESSAGES_TRUE@	@echo '    fix-macos-mbedtls-lib-links.sh'
@ENABLE_INSTALL_MESSAGES_TRUE@	@echo
@ENABLE_INSTALL_MESSAGES_TRUE@	@echo '    ───────────────────────────────────────────────────────────'
@ENABLE_INSTALL_MESSAGES_TRUE@	@echo

@ENABLE_GCOV_TRUE@cov-clean:
@ENABLE_GCOV_TRUE@	@rm -rf coverage
@ENABLE_GCOV_TRUE@	@find . -name "*.gcda" -exec rm {} \;
@ENABLE_GCOV_TRUE@	@find . -name "*.gcno" -exec rm {} \;
@ENABLE_GCOV_TRUE@	@lcov --directory . --zerocounters

@ENABLE_GCOV_TRUE@cov-report:
@ENABLE_GCOV_TRUE@	@mkdir -p coverage
@ENABLE_GCOV_TRUE@	@lcov --compat-libtool --directory . -b . --capture --output-file coverage/app.info
@ENABLE_GCOV_TRUE@	@genhtml -o coverage/ coverage/app.info

@ENABLE_GCOV_TRUE@cov:
@ENABLE_GCOV_TRUE@	@make cov-report

